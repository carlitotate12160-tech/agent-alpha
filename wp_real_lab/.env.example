# WP Real-World Lab — environment variables
# Copy to .env and set values before running seed.sh.
# DO NOT commit .env (gitignored).

# MariaDB
MARIADB_ROOT_PASSWORD=REPLACE_WITH_LAB_VALUE
MARIADB_DATABASE=wp_alpha_ai
MARIADB_USER=wpadmin

# The leaked DB password — this is the credential that gets exposed via
# /wp-config.php.bak AND reused as the WP admin password (the chain).
# For the cross-service cred-reuse chain, set this to the same value as the
# laravel_real_lab/.env:DB_PASSWORD and the DB password used by the other alpha-ai stacks.
LEAKED_DB_PASSWORD=REPLACE_WITH_LAB_VALUE

# WP admin username (same as DB_USER for maximum cred-reuse realism)
LEAKED_WP_ADMIN=wpadmin
