# Agent-Alpha root environment — COPY to .env (gitignored) and fill with real values.
# NEVER commit .env or real secrets.

# DeepSeek API (reasoning + payload provider)
DEEPSEEK_API_KEY=CHANGE_ME

# PostgreSQL event store (matches infra/.env + infra/init-db.sql)
# agent_alpha_app role is created by infra/init-db.sql with NOSUPERUSER NOBYPASSRLS
AGENT_ALPHA_PG_DSN=postgresql://agent_alpha_app:natanael12160@127.0.0.1:5432/agent_alpha

# Redis session store (password must match infra/.env REDIS_PASSWORD)
REDIS_URL=redis://:CHANGE_ME_strong_unique@127.0.0.1:6379/0

# browser_solve service (9c, DeepSeek lane) — endpoint for CF/Turnstile solver
# When set, a1_validation_runner uses DeepSeekBrowserSolve to solve challenges.
# When unset, _NoopBrowserSolve raises (fail-loud — no false success).
# Run the service: uvicorn agent_alpha.live_fire.browser_solve_service:app --port 8080
A1_BROWSER_SOLVE_ENDPOINT=
A1_BROWSER_SOLVE_API_KEY=

# Profile signing key (HMAC-SHA-256). Must be >=32 decoded bytes (>=64 hex chars).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PROFILE_SIGNING_KEY=CHANGE_ME_64_hex_chars

# Origin IP discovery — multi-source subdomain enumeration
# crt.sh + hackertarget + AlienVault OTX: free, no API key needed
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
