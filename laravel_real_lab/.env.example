# Laravel Real-World Lab — environment variables
# Copy to .env and set values before running seed.sh.
# DO NOT commit .env (gitignored).

# MySQL
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LAB_VALUE
DB_DATABASE=laravel_alpha_ai
DB_USER=laravel_admin

# The DB password that gets leaked via Whoops debug page AND may be reused
# cross-service (WP or Odoo). For cross-service chain, set this to the
# SAME value as wp_real_lab/.env:LEAKED_DB_PASSWORD.
DB_PASSWORD=REPLACE_WITH_LAB_VALUE
